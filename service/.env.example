# ===== Embedding API（内部 OpenAI 兼容接口，bge-m3）=====
EMBEDDING_API_URL=http://10.12.3.93:19997/v1/embeddings
# 必填：填入你的 Embedding API Key（请勿提交到版本库）
EMBEDDING_API_KEY=__PUT_YOUR_EMBEDDING_API_KEY_HERE__
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ===== LLM API（默认档：小模型，用于分类/query 理解）=====
LLM_API_URL=http://10.12.3.31:9997/v1/chat/completions
LLM_API_KEY=__PUT_YOUR_LLM_API_KEY_HERE__
LLM_MODEL=qwen-internal

# ===== LLM 大模型档（可选：用于 rerank / 冲突治理，质量优先）=====
# 留空则不启用大模型，所有任务回退默认档
# LLM_API_URL_LARGE 留空 = 沿用 LLM_API_URL
LLM_MODEL_LARGE=
LLM_API_KEY_LARGE=
LLM_API_URL_LARGE=

# 单次 LLM 请求超时（秒）
LLM_TIMEOUT_SECONDS=60

# ===== 按任务指定模型档位（small | large）=====
LLM_TIER_CLASSIFY=small
LLM_TIER_QUERY_ANALYSIS=small
LLM_TIER_RERANK=large
LLM_TIER_GOVERNANCE=large

# ===== Qdrant（Docker 本地启动）=====
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=memories

# ===== SQLite 元数据库 =====
SQLITE_DB_PATH=./memory.db

# ===== 服务自身 =====
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
# 可选：配置后 /add 和 /search 需要 X-Api-Key 头校验；留空则放行
SERVICE_API_KEY=

# ===== 行为参数 =====
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=2
MAX_MESSAGES_PER_ADD=20

# ===== 链路 2~5 功能开关（true/false）=====
ENABLE_CHUNKING=true
ENABLE_BM25=true
ENABLE_RERANK=true
ENABLE_CLASSIFICATION=true
ENABLE_QUERY_ANALYSIS=true
ENABLE_GOVERNANCE=true

# ===== 链路 2~5 调优参数 =====
# 语义分块目标长度（英文按词/中文按字估算）
CHUNK_TARGET_MIN=150
CHUNK_TARGET_MAX=250
# 分块时间跨度阈值（毫秒），超过则切分
CHUNK_TIME_GAP_MS=3600000
# 是否按说话人切换切分（默认 false = 不切）
# false：跨说话人聚合到接近 CHUNK_TARGET_MAX 才切，块内保留 "{role}: {content}" 前缀
# true ：恢复旧行为，user/assistant 交替即切分
CHUNK_SPLIT_ON_SPEAKER=false
# 是否在分块内容最前面注入会话日期前缀（形如 "[2023-07-03 July 2023] "）
# 作用：把 "this month"/"yesterday" 等相对时间关联到真实日期，修复时间类问题
CHUNK_DATE_PREFIX=true
# 混合召回（扩大候选池可提升相关记忆召回）
VECTOR_TOP_K=100
BM25_TOP_K=100
# LLM Rerank
RERANK_CANDIDATE_LIMIT=30
RERANK_TIMEOUT_SECONDS=60
# rerank prompt 中每条候选内容的最大字符数（0=不截断）；截断可显著降延迟
RERANK_MAX_CHARS=320
RERANK_WEIGHT=0.7
VECTOR_WEIGHT=0.3
# 查询理解超时
QUERY_ANALYSIS_TIMEOUT_SECONDS=30
# 记忆治理
GOVERNANCE_IMPORTANCE_BOOST=0.05
GOVERNANCE_IMPORTANCE_CAP=2.0

# ===== P1：写入侧原子事实抽取（双表示）=====
# true=每个分块额外抽原子事实(kind='fact')入库，原始分块仍入库(kind='chunk')
ENABLE_FACT_EXTRACTION=true
# 事实去重阈值：与同 user 已有事实余弦相似度 >= 该值则跳过
FACT_DEDUP_THRESHOLD=0.95
# 每个分块最多抽取多少条事实（<=0 表示不抽取）
FACT_MAX_PER_CHUNK=8

# ===== P2：实体关联索引 + 多跳扩展 =====
# true=维护 entity->memory_id 倒排索引，检索时沿实体做 1 跳扩展
# 实测对 LoCoMo 有害（引入噪声），默认关闭
ENABLE_ENTITY_EXPANSION=false
# 扩展时取候选集中出现频次最高的前 N 个实体
ENTITY_EXPAND_TOP=5
# 每次检索最多补充多少条关联记忆
ENTITY_EXPAND_LIMIT=20

# ===== P3：检索侧减负（便于 A/B）=====
# hard=现有 0~10 整数 LLM 打分；off=不调 LLM，按向量/BM25 融合分排序
RERANK_MODE=hard
# true=排序时给 kind='fact' 的记忆加成，让事实优先于长分块
# 实测在小模型 rerank 下有害，默认关闭
PREFER_FACTS=false
# 事实加成值（加到最终分数上）
FACT_BOOST=0.05

# ===== Passage Integration：检索返回时把事实的源分块原文一并带上 =====
# true=命中 kind='fact' 时，附加上其 source_id 指向的原始分块原文（{事实}\n[原文] {源分块}）
# 指标为 top-k 文本并集覆盖率，附带完整源分块可提升覆盖，故默认不截断
ENABLE_PASSAGE_INTEGRATION=true
# 附加的源分块原文最大字符数（0=不截断）
PASSAGE_MAX_CHARS=0
